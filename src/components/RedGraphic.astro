---
// The red "speed" graphic from René's business card: ONE connected red shape.
// Rounded fingers reach in from the left, separated by thin gaps whose rounded ends
// leave rounded inner corners. Fingers run all the way down, so there is no solid block.
// Built as a mask: white = red, black = the gaps.
interface Props {
  id: string;
  class?: string;
  width: number;
  height: number;
  /** Left end (x) of each finger, top to bottom. Fingers fill the full height. */
  lefts: number[];
  /** Finger thickness and gap thickness (viewBox units). */
  finger: number;
  gap: number;
  /** How far past the longer neighbour each gap reaches into the red (cycled). */
  reach: number[];
  /** Red always kept solid along the right edge, so the shape stays connected. */
  solid: number;
}
const { id, class: className, width, height, lefts, finger, gap, reach, solid } = Astro.props;
const far = width + 400; // fingers run past the right edge
const O = 2; // white shapes overlap slightly so no hairline seams show

const pitch = finger + gap;
const fingers = lefts.map((x, i) => {
  const y = i * pitch;
  const last = i === lefts.length - 1;
  // the last finger stretches to the bottom edge
  const h = last ? Math.max(finger, height - y) : finger;
  return { x, y, h, i };
});
const gaps = fingers.slice(0, -1).map((f, i) => {
  const next = fingers[i + 1];
  const end = Math.min(width - solid, Math.max(f.x, next.x) + reach[i % reach.length]);
  return { y: f.y + f.h, h: gap, end, i };
});
---

<svg
  class:list={['red-graphic', className]}
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMaxYMin slice"
  aria-hidden="true"
  focusable="false">
  <defs>
    <mask id={`${id}-mask`} maskUnits="userSpaceOnUse" x="-200" y="0" width={far + 400} height={height}>
      {
        fingers.map((f) => (
          <rect
            class="red-graphic__bar"
            style={`--i:${f.i}`}
            x={f.x}
            y={f.y - O}
            width={far - f.x}
            height={f.h + 2 * O}
            rx={Math.min(finger / 2, f.h / 2)}
            fill="#fff"
          />
        ))
      }
      {
        // red behind each gap's rounded end (moves with the finger above it)
        gaps.map((g) => (
          <rect class="red-graphic__bar" style={`--i:${g.i}`} x={g.end - gap} y={g.y - O} width={far} height={gap + 2 * O} fill="#fff" />
        ))
      }
      {gaps.map((g) => <rect x="-200" y={g.y} width={g.end + 200} height={g.h} rx={g.h / 2} fill="#000" />)}
    </mask>
    <linearGradient id={`${id}-fill`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e32b2b"></stop>
      <stop offset="1" stop-color="#d21f24"></stop>
    </linearGradient>
  </defs>
  <rect x="-200" y="0" width={far + 400} height={height} fill={`url(#${id}-fill)`} mask={`url(#${id}-mask)`}></rect>
</svg>

<style>
  .red-graphic {
    display: block;
    width: 100%;
    height: 100%;
  }
  .red-graphic__bar {
    transform-box: view-box;
  }
</style>

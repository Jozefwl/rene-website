---
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { whatsappLink } from '../lib/contact';
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class:list={['sticky', { 'sticky--en': lang === 'en' }]}>
  <a class="sticky__btn sticky__btn--call" href={business.phoneHref}>
    <Icon name="mdi:phone" aria-hidden="true" /><span>{t.sticky.call}</span>
  </a>
  <a class="sticky__btn sticky__btn--wa" href={whatsappLink()} target="_blank" rel="noopener">
    <Icon name="mdi:whatsapp" aria-hidden="true" /><span>{t.sticky.whatsapp}</span>
  </a>
</div>

<style>
  .sticky {
    display: none;
  }
  @media (max-width: 900px) {
    .sticky {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
      background: rgba(255, 255, 255, 0.97);
      box-shadow: 0 -6px 20px rgba(20, 22, 26, 0.1);
    }
    .sticky--en .sticky__btn--call {
      order: 2;
    }
    .sticky__btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 50px;
      border-radius: 12px;
      color: var(--white);
      font-weight: 700;
      text-decoration: none;
    }
    .sticky__btn svg {
      width: 22px;
      height: 22px;
    }
    .sticky__btn--call {
      background: var(--red);
    }
    .sticky__btn--wa {
      background: var(--whatsapp);
    }
  }
</style>

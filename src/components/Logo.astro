---
interface Props {
  href: string;
  invert?: boolean;
}
const { href, invert = false } = Astro.props;
---

<a class:list={["logo", { "logo--invert": invert }]} href={href}>
  <span class="logo__rr">R&amp;R</span>
  <span class="logo__name">AUTODOPRAVA</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }
  .logo__rr {
    color: var(--red);
    font-size: 1.65rem;
  }
  .logo__name {
    color: var(--ink);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
  }
  .logo--invert .logo__name {
    color: var(--white);
  }
</style>

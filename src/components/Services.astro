---
import { Icon } from 'astro-icon/components';
import { whatsappLink } from '../lib/contact';
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---

<section id="sluzby" class="section" aria-labelledby="services-title">
  <div class="container">
    <h2 id="services-title" class="section-title reveal">{t.services.title}</h2>
    <p class="section-lead reveal">{t.services.lead}</p>

    <!-- Each service is a native <details>: opens on click/tap, works without JavaScript, accessible by keyboard. -->
    <ul class="services reveal">
      {
        t.services.items.map((s) => (
          <li>
            <details class="service">
              <summary class="service__head">
                <span class="service__icon"><Icon name={s.icon} aria-hidden="true" /></span>
                <span class="service__title">{s.title}</span>
                <span class="service__chevron"><Icon name="mdi:chevron-down" aria-hidden="true" /></span>
              </summary>
              <div class="service__body">
                <p>{s.text}</p>
                <ul class="service__points">
                  {s.points.map((pt) => (
                    <li>
                      <Icon name="mdi:check-circle" aria-hidden="true" />
                      <span>{pt}</span>
                    </li>
                  ))}
                </ul>
                <a class="btn btn--whatsapp service__cta" href={whatsappLink(`${t.services.interestMsg} ${s.title}`)} target="_blank" rel="noopener">
                  <Icon name="mdi:whatsapp" aria-hidden="true" />
                  <span>{t.services.interest}</span>
                </a>
              </div>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 14px 20px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  .service {
    border: 1px solid var(--line);
    border-left: 5px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .service:hover,
  .service[open] {
    border-left-color: var(--red);
  }
  .service[open] {
    box-shadow: var(--shadow-strong);
  }
  .service__head {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 72px;
    padding: 12px 18px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .service__head::-webkit-details-marker {
    display: none;
  }
  .service__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex: none;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
  }
  .service__icon :global(svg) {
    width: 26px;
    height: 26px;
  }
  .service__title {
    flex: 1;
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.3;
  }
  .service__chevron {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    background: var(--bg-alt);
    color: var(--ink);
    transition: transform 0.25s, background-color 0.2s, color 0.2s;
  }
  .service__chevron :global(svg) {
    width: 24px;
    height: 24px;
  }
  .service__head:hover .service__chevron {
    background: var(--red-soft);
    color: var(--red);
  }
  .service[open] .service__chevron {
    transform: rotate(180deg);
    background: var(--red);
    color: var(--white);
  }
  .service__body {
    padding: 0 20px 20px 80px;
    color: var(--ink-soft);
  }
  .service[open] .service__body {
    animation: open 0.25s ease-out;
  }
  @keyframes open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .service__points {
    display: grid;
    gap: 6px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink);
  }
  .service__points li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .service__points :global(svg) {
    width: 20px;
    height: 20px;
    flex: none;
    margin-top: 2px;
    color: var(--red);
  }
  .service__cta {
    min-height: 44px;
    margin-top: 16px;
    padding: 8px 20px;
    font-size: 0.95rem;
  }
  @media (max-width: 820px) {
    .services {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .service__body {
      padding-left: 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .service[open] .service__body {
      animation: none;
    }
  }
</style>

---
import { Icon } from 'astro-icon/components';
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---

<section id="sluzby" class="section" aria-labelledby="services-title">
  <div class="container">
    <h2 id="services-title" class="section-title reveal">{t.services.title}</h2>
    <p class="section-lead reveal">{t.services.lead}</p>

    <!-- Bullet list of services; one button shows / hides all descriptions.
         Without JavaScript the descriptions are simply always visible. -->
    <ul class="services reveal" id="services-list" data-services>
      {
        t.services.items.map((s) => (
          <li class="service">
            <span class="service__icon">
              <Icon name={s.icon} aria-hidden="true" />
            </span>
            <div>
              <h3 class="service__title">{s.title}</h3>
              <p class="service__text">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <button
      class="btn btn--outline services__toggle reveal"
      type="button"
      aria-controls="services-list"
      aria-expanded="false"
      data-services-toggle
      data-more={t.services.more}
      data-less={t.services.less}>
      <span data-services-label>{t.services.more}</span>
      <Icon name="mdi:chevron-down" class="services__chevron" aria-hidden="true" />
    </button>
  </div>
</section>

<script>
  const list = document.querySelector<HTMLElement>('[data-services]');
  const btn = document.querySelector<HTMLButtonElement>('[data-services-toggle]');
  const label = btn?.querySelector<HTMLElement>('[data-services-label]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    list?.classList.toggle('is-open', open);
    if (label) label.textContent = (open ? btn.dataset.less : btn.dataset.more) ?? '';
  });
</script>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 40px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .service {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .service__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
  }
  .service__icon :global(svg) {
    width: 24px;
    height: 24px;
  }
  .service__title {
    margin-top: 9px;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .service__text {
    margin-top: 6px;
    color: var(--ink-soft);
  }
  /* With JS: descriptions hidden until the button is pressed. */
  :global(.js) .service__text {
    display: none;
  }
  :global(.js) .services.is-open .service__text {
    display: block;
    animation: show 0.25s ease-out;
  }
  @keyframes show {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .services__toggle {
    display: none;
    margin-top: 24px;
  }
  :global(.js) .services__toggle {
    display: inline-flex;
  }
  .services__toggle :global(.services__chevron) {
    transition: transform 0.25s;
  }
  .services__toggle[aria-expanded='true'] :global(.services__chevron) {
    transform: rotate(180deg);
  }
  @media (max-width: 820px) {
    .services {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .services.is-open .service__text {
      animation: none;
    }
  }
</style>

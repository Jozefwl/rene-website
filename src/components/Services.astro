---
import { Icon } from 'astro-icon/components';
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---

<section id="sluzby" class="section" aria-labelledby="services-title">
  <div class="container">
    <h2 id="services-title" class="section-title reveal">{t.services.title}</h2>
    <p class="section-lead reveal">{t.services.lead}</p>
    <ul class="cards">
      {
        t.services.items.map((s) => (
          <li class="card reveal">
            <span class="icon-circle"><Icon name={s.icon} aria-hidden="true" /></span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  .card {
    position: relative;
    padding: 28px 26px 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background: var(--red);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.25s;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-strong);
  }
  .card:hover::before {
    transform: scaleY(1);
  }
  h3 {
    margin-top: 18px;
    font-size: 1.2rem;
    font-weight: 700;
  }
  p {
    margin-top: 8px;
    color: var(--ink-soft);
  }
  @media (max-width: 600px) {
    .cards {
      gap: 12px;
      margin-top: 28px;
    }
    .card {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 16px;
      padding: 18px;
    }
    .card .icon-circle {
      grid-row: span 2;
      width: 46px;
      height: 46px;
    }
    h3 {
      margin-top: 2px;
      font-size: 1.08rem;
    }
    p {
      margin-top: 4px;
      font-size: 0.95rem;
    }
  }
</style>

---
// Side view of René's van: white Peugeot Boxer L4H2 (long body, high roof).
// Drawn to scale: 100 units ≈ 1 m (length 6.36 m, height 2.52 m). Facing left.
interface Props {
  id: string;
  label: string;
  class?: string;
  /** Show cargo-space dimension arrows (Vehicle section). */
  dims?: { length: string; height: string };
}

const { id, label, class: className, dims } = Astro.props;
const viewBox = dims ? '-10 -56 724 322' : '-10 -6 660 272';
const spokes = [0, 60, 120];
const wheels = [97, 501];
---

<svg class:list={['van', className]} viewBox={viewBox} role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={`${id}-body`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="0.75" stop-color="#f3f4f6"></stop>
      <stop offset="1" stop-color="#dcdfe3"></stop>
    </linearGradient>
    <linearGradient id={`${id}-glass`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4a5560"></stop>
      <stop offset="1" stop-color="#1d2329"></stop>
    </linearGradient>
  </defs>

  <ellipse class="van-shadow" cx="320" cy="258" rx="318" ry="7" fill="#000" opacity=".18"></ellipse>

  <g class="van-body">
    <g fill="#16181b">
      <path d="M50 230 A47 47 0 0 1 144 230 Z"></path>
      <path d="M454 230 A47 47 0 0 1 548 230 Z"></path>
    </g>
    <path
      d="M8 226 C4 214 3 200 5 186 C7 172 10 163 18 156 C40 146 78 136 116 128 L164 58 C170 48 178 40 192 34 L232 14 C240 9 248 6 262 6 L622 6 C632 6 636 12 636 20 L636 220 C636 226 632 230 626 230 L548 230 A46 46 0 0 0 454 230 L144 230 A46 46 0 0 0 50 230 Z"
      fill={`url(#${id}-body)`}
      stroke="#b9bec5"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
    <path d="M116 128 L164 58 C168 52 172 48 178 45 L174 50 L126 126 Z" fill={`url(#${id}-glass)`}></path>
    <path d="M132 126 L174 62 C178 56 184 53 192 53 L226 53 L226 126 Z" fill={`url(#${id}-glass)`}></path>
    <g stroke="#c4c8ce" stroke-width="2">
      <path d="M230 30 L230 228"></path>
      <path d="M126 130 L126 228"></path>
      <path d="M410 12 L410 228"></path>
      <path d="M630 10 L630 226" stroke-width="1.5"></path>
      <path d="M232 22 L404 22" stroke-width="1.5"></path>
    </g>
    <rect x="410" y="98" width="214" height="4" rx="2" fill="#c4c8ce"></rect>
    <g fill="#2b2f34">
      <rect x="200" y="140" width="20" height="5" rx="2.5"></rect>
      <rect x="240" y="140" width="20" height="5" rx="2.5"></rect>
      <path d="M144 196 L454 196 L454 212 L144 212 Z"></path>
      <path d="M548 196 L634 196 L634 212 L548 212 Z"></path>
      <path d="M6 190 L58 190 C56 196 53 204 51 212 L50 230 L8 226 C5 216 4 204 6 190 Z"></path>
      <path d="M6 174 L20 172 L20 186 L6 188 Z"></path>
      <path d="M120 96 L132 92 L136 124 L124 126 Z"></path>
      <path d="M554 214 L636 214 L636 222 C636 227 632 230 627 230 L554 230 Z"></path>
    </g>
    <g fill="none" stroke="#2b2f34" stroke-width="7">
      <path d="M44 230 A52 52 0 0 1 150 230"></path>
      <path d="M448 230 A52 52 0 0 1 554 230"></path>
    </g>
    <path class="van-headlight" d="M14 158 C30 152 52 147 74 143 L70 158 C52 161 32 165 12 170 Z" fill="#e4eaf1" stroke="#9aa3ad" stroke-width="1"></path>
    <path d="M70 146 L82 143 L79 156 L68 158 Z" fill="#f6a23a"></path>
    <rect x="628" y="150" width="8" height="36" rx="2" fill="#d6262b"></rect>
    <g font-family="Poppins, Arial, sans-serif" font-weight="800" text-anchor="middle" aria-hidden="true">
      <text x="420" y="138" font-size="34" fill="#e32b2b">R&amp;R</text>
      <text x="420" y="166" font-size="22" fill="#2a2a2a" letter-spacing="1">AUTODOPRAVA</text>
    </g>
  </g>

  {
    wheels.map((x) => (
      <g transform={`translate(${x} 222)`}>
        <g class="van-wheel">
          <circle r="36" fill="#1f2226" />
          <circle r="22" fill="#9aa1a9" />
          <circle r="22" fill="none" stroke="#6f767e" stroke-width="2" />
          <g fill="#6f767e">
            {spokes.map((a) => (
              <rect x="-2.5" y="-20" width="5" height="40" rx="2" transform={`rotate(${a})`} />
            ))}
          </g>
          <circle r="6" fill="#4b5158" />
        </g>
      </g>
    ))
  }

  {
    dims && (
      <g class="van-dims" font-family="Poppins, Arial, sans-serif" font-weight="700" font-size="22" fill="#e32b2b">
        <g stroke="#e32b2b" stroke-width="2.5" fill="none">
          <path d="M232 -24 L632 -24" />
          <path d="M232 -36 L232 -12 M632 -36 L632 -12" />
          <path d="M246 -32 L232 -24 L246 -16 M618 -32 L632 -24 L618 -16" />
          <path d="M662 14 L662 202" />
          <path d="M650 14 L674 14 M650 202 L674 202" />
          <path d="M654 28 L662 14 L670 28 M654 188 L662 202 L670 188" />
          <path d="M232 14 L632 14 L632 202 L232 202 Z" stroke-dasharray="8 7" stroke-width="2" opacity=".55" />
        </g>
        <text x="432" y="-34" text-anchor="middle">{dims.length}</text>
        <text x="0" y="0" text-anchor="middle" transform="translate(698 108) rotate(-90)">{dims.height}</text>
      </g>
    )
  }
</svg>

<style>
  .van-wheel {
    transform-box: fill-box;
    transform-origin: center;
  }
</style>

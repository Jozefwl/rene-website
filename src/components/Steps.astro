---
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---

<section id="ako-to-funguje" class="section section--alt" aria-labelledby="how-title">
  <div class="container">
    <h2 id="how-title" class="section-title reveal">{t.how.title}</h2>
    <ol class="steps">
      {
        t.how.steps.map((s, i) => (
          <li class="step reveal">
            <span class="step__num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 44px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .step {
    position: relative;
    padding: 28px 26px;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
  }
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 52px;
    right: -24px;
    width: 24px;
    height: 4px;
    background: var(--red);
  }
  .step__num {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
    font-weight: 800;
    font-size: 1.5rem;
  }
  h3 {
    margin-top: 18px;
    font-size: 1.2rem;
    font-weight: 700;
  }
  p {
    margin-top: 8px;
    color: var(--ink-soft);
  }
  @media (max-width: 820px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .step:not(:last-child)::after {
      top: auto;
      bottom: -16px;
      left: 50px;
      right: auto;
      width: 4px;
      height: 16px;
    }
  }
</style>

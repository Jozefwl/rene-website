---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TruckIcon from '../components/TruckIcon.astro';
import sk from '../i18n/sk';
import en from '../i18n/en';
---

<Base lang="sk" page="home" title={`${sk.notFound.title} | R&R Autodoprava`} description={sk.notFound.text} noindex>
  <Header lang="sk" page="home" />
  <main class="section nf">
    <div class="container nf__inner">
      <div class="nf__van"><TruckIcon label={sk.a11y.vanAlt} /></div>
      <h1 class="section-title">{sk.notFound.title}</h1>
      <p class="section-lead">{sk.notFound.text}</p>
      <p class="nf__en" lang="en">{en.notFound.title}. {en.notFound.text}</p>
      <div class="nf__cta btn-row">
        <a class="btn btn--red" href="/">{sk.notFound.back}</a>
        <a class="btn btn--outline" href="/en/" lang="en">{en.notFound.back}</a>
      </div>
    </div>
  </main>
  <Footer lang="sk" />
</Base>

<style>
  .nf__van {
    width: min(340px, 80%);
    margin-bottom: 32px;
  }
  .nf__en {
    margin-top: 8px;
    color: var(--muted);
  }
  .nf__cta {
    margin-top: 28px;
  }
</style>

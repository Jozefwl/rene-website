---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '../styles/global.css';
import { business } from '../data/business';
import { routes, type Lang, type PageId } from '../i18n';

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  description: string;
  ogAlt?: string;
  schema?: Record<string, unknown>;
  noindex?: boolean;
}

const { lang, page, title, description, ogAlt, schema, noindex = false } = Astro.props;
const site = Astro.site ?? new URL(business.site);
const canonical = new URL(routes[page][lang], site).href;
const alternates = (['sk', 'en'] as const).map((l) => ({ lang: l, href: new URL(routes[page][l], site).href }));
const ogImage = new URL('/og-image.png', site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <meta name="theme-color" content="#e32b2b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta property="og:locale" content={lang === 'sk' ? 'sk_SK' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Runs before paint: marks JS as available and plays the intro only once per session. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          if (sessionStorage.getItem('rr-intro-seen')) d.classList.add('no-intro');
          else sessionStorage.setItem('rr-intro-seen', '1');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Fade sections in as they scroll into view.
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }

      // Button rows (.btn-row): every button gets the widest button's natural width.
      // If they don't fit side by side, the row stacks into one column.
      function sizeButtonRow(row: HTMLElement) {
        const btns = [...row.children] as HTMLElement[];
        let widest = 0;
        for (const b of btns) {
          b.style.width = 'max-content';
          b.style.whiteSpace = 'nowrap';
          widest = Math.max(widest, b.getBoundingClientRect().width);
          b.style.width = '';
          b.style.whiteSpace = '';
        }
        if (!widest) return; // hidden row, sized again once it appears
        const w = Math.ceil(widest);
        row.style.setProperty('--btn-w', `${w}px`);
        row.classList.remove('is-stacked');
        const gap = parseFloat(getComputedStyle(row).columnGap) || 0;
        // Room comes from the nearest ancestor with a box (the hero text is display: contents on mobile).
        let box = row.parentElement;
        while (box && getComputedStyle(box).display === 'contents') box = box.parentElement;
        // clientWidth includes padding, so subtract it to get the real room.
        let room = Infinity;
        if (box) {
          const bs = getComputedStyle(box);
          room = box.clientWidth - parseFloat(bs.paddingLeft) - parseFloat(bs.paddingRight);
        }
        if (btns.length * w + (btns.length - 1) * gap > room) row.classList.add('is-stacked');
      }
      const rows = document.querySelectorAll<HTMLElement>('.btn-row');
      const sizeAll = () => rows.forEach(sizeButtonRow);
      sizeAll();
      document.fonts?.ready.then(sizeAll);
      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(sizeAll, 100);
      });
      // Catches rows that start hidden (the email fallback) once they appear.
      if ('ResizeObserver' in window) {
        const ro = new ResizeObserver((entries) => {
          for (const e of entries) {
            e.target.querySelectorAll<HTMLElement>(':scope > .btn-row').forEach(sizeButtonRow);
          }
        });
        rows.forEach((row) => row.parentElement && ro.observe(row.parentElement));
      }
    </script>
  </body>
</html>
